# Copy to .env and fill in. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, e.g. https://track.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 0 when serving plain HTTP (e.g. on a LAN without a TLS proxy)
DJANGO_BEHIND_TLS=1
# Set to 1 to force-redirect HTTP->HTTPS at the app level
DJANGO_SSL_REDIRECT=0
